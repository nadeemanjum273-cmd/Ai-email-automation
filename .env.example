# Supabase Connection
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App URL (for OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth 2.0 Credentials (Google Cloud Console: Gmail API & Google Sheets API enabled)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Google Gemini API Key (for AI Niche Personalization)
GEMINI_API_KEY=your_gemini_api_key

# Target Business Model Config
NEXT_PUBLIC_PLAN_PRICE_PKR=3000
NEXT_PUBLIC_DAILY_EMAIL_QUOTA=50
NEXT_PUBLIC_MONTHLY_EMAIL_QUOTA=1500
